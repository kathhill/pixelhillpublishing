---
import "../styles/global.css";
import "../styles/global.scss";
import { Image } from "astro:assets";
import icon from "../assets/icon.png";
import Navigation from "../components/Navigation.astro";
import External from "../components/External.astro";
interface Props {
	title: string;
	description: string;
}

const { title } = Astro.props;
const { description } = Astro.props;

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<External />
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/x-icon" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<a class="sr-only focus:not-sr-only skip-link" href="#about"
			>Skip to main content</a
		>
		<header id="header">
			<h1>
				<a href="/" rel="home">
					<Image class="icon" src={icon} alt="Pixel Hill" />
				</a>
			</h1>
			<Navigation />
		</header>

		<slot />

		<footer>
			<p>
				&copy;<span id="footer-year">{year}</span>&nbsp;Pixel Hill Publishing.
				All rights reserved.
			</p>
		</footer>
	</body><script is:inline data-astro-rerun>
		document.getElementById("footer-year").innerText = new Date().getFullYear();

		const menu = document.getElementById("menu");
		const menuToggle = document.getElementById("menu-toggle");

		menu.addEventListener("click", handleMenuClick);

		function handleMenuClick(event) {
			if (event.target instanceof HTMLAnchorElement) {
				menuToggle.checked = false;
			}
		}
	</script>
	<script>
		window.addEventListener("scroll", () => {
			const header = document.getElementById("header");
			if (window.scrollY > 100) {
				// Threshold in pixels
				header?.classList.add("scrolled");
			} else {
				header?.classList.remove("scrolled");
			}
		});
	</script>
</html>

<style lang="scss" is:global>
	:root {
		--color-text-reverse: #fff;
		--headerOpacity: 1;
		--headerScale: 1;
		--shortHeight: var();
	}

	header {
		background: transparent;
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding: 0;
		position: fixed;
		width: 100%;
		z-index: 10;

		.icon {
			height: 4rem;
			padding: 0.5rem;
			width: 4rem;
		}

		&.scrolled {
			background: #000;
			box-shadow: 0px 2px 2px 0px rgba(0, 0, 0, 0.75);
		}
	}
</style>
