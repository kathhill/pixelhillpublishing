<form
	action="https://usebasin.com/f/82e2d4e2d14b"
	method="post"
	id="download-form"
	class="flex flex-col p-4 bg-cyan-600/50 text-black drop-shadow-2xl rounded-lg border-2 border-cyan-700 mx-2 mb-10 lg:w-150 lg:items-center lg:justify-center"
>
	<p class="text-2xl! lg:text-xl! text-center" id="email-description">
		Please enter your email to receive your bonus
	</p>
	<input
		id="email"
		type="text"
		name="email"
		aria-describedby="email-description"
		placeholder="you@example.com"
		autocomplete="email"
		class="h-10 p-2 w-full lg:w-100 rounded-md text-2xl! lg:text-xl! text-black border-2 border-cyan-700"
		required
	/>

	<button
		type="submit"
		class="mt-8 p-2 bg-cyan-700 text-white text-2xl! lg:text-xl! rounded hover:opacity-70"
	>
		Submit &amp; Download
	</button>
</form>
<script>
	const downloadForm =
		document.querySelector<HTMLFormElement>("#download-form");
	downloadForm?.addEventListener("submit", (e) => {
		e.preventDefault();

		const formData = new FormData(downloadForm);
		fetch("https://usebasin.com/f/82e2d4e2d14b", {
			method: "POST",
			headers: {
				Accept: "application/json",
			},
			body: formData,
		})
			.then((response) => {
				if (response.status === 200) {
					console.log("success");
				} else {
					console.log("failure");
				}
			})
			.catch((error) => console.log(error));

		const pdfUrl = "/dl/mermaids/mermaid-coloring-pages.pdf";
		const fileName = "mermaid-coloring-pages.pdf";

		const link = document.createElement("a");
		link.href = pdfUrl;
		link.download = fileName;
		document.body.appendChild(link);
		link.click();
		document.body.removeChild(link);
	});
</script>
